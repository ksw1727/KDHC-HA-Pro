# ── 로컬 실행(npm run dev): AI로 만들기는 OpenAI SDK 엔진. 이 파일을 .env.local로 복사하고 키를 넣는다
OPENAI_API_KEY=
# MOA_OPENAI_PROMPT=B   # 시스템 프롬프트 버전 A·B·C

# ── 온라인(Vercel + Neon) 모드: VITE_CLOUD_MODE=true. 로컬 실행에서는 비워 두거나 false
VITE_CLOUD_MODE=false
# 공개 HTTPS Data API 주소. PostgreSQL 비밀 연결 문자열이 아닙니다.
VITE_NEON_DATA_API_URL=

# 아래는 서버 전용. VITE_ 접두어를 붙이지 마세요.
DATABASE_URL=
NEON_AUTH_BASE_URL=
# 운영 사이트의 정확한 출처. 개발 중에는 http://localhost:5176 등
SERVER_APP_ORIGIN=
# 온라인 공용 OpenAI: 위 OPENAI_API_KEY와 함께 모델 이름도 있어야 화면에서 활성화됩니다.
OPENAI_MODEL=
# 선택: 클로드를 추가할 경우에만
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# AI 사용 한도는 환경변수가 아니라 관리자 페이지에서 정합니다(기본 무제한).

# --- 로컬 실행 전용: 키 없이 올라마(Ollama)로 AI로 만들기 (온라인 배포에는 쓰지 않음) ---
# npm run dev 에서 OPENAI_API_KEY가 없어도 이 컴퓨터 올라마에 받아 둔 모델(예: ollama pull gemma4:26b)을 고를 수 있다.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# MOA_OLLAMA_MODELS=gemma4:26b          # 보여 줄 모델만 쉼표로 (비우면 도구를 쓸 수 있는 모델 전부)
